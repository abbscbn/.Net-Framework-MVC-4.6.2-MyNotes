@using MyNotes.Entities;
@using MyNotes.WebApp.Models;

@model List<Note>

@{
    ViewBag.Title = "MyNotes";

}
@{
    var currentUser = CurrentSession.User;
}

<link href="~/Content/Site.css" rel="stylesheet" />


<div class="container-xxl mt-3">
    <div class="row text-center justify-content-center">
        <div class="col-md-6">
            <h3>@ViewBag.foundedUser'ın Tarifleri</h3>
        </div>
    </div>
    <div class="row">


        <!-- Blog entries-->
        <div class="col-md-12">

            <!-- Nested row for non-featured blog posts-->
            <div class="row">


                @foreach (Note note in Model)
                {
                    <div class="col-lg-4 col-md-6" data-note-id="@note.Id">
                        <div class="card mb-4 shadow-sm border-1">

                            <!-- Card Header (Profil + Kullanıcı) -->
                            <div class="card-header bg-white d-flex align-items-center gap-2">

                                <a href="@Url.Action("Profile", "Home", new { id = note.Owner.Id })"
                                   class="d-flex align-items-center gap-2 text-decoration-none text-dark">

                                    <img src="~/Images/@(note.Owner.ProfileImageFilename ?? "user.webp")"
                                         class="rounded-circle"
                                         width="40"
                                         height="40"
                                         alt="Profil" />

                                    <strong class="hover-underline">
                                        @note.Owner.Username
                                    </strong>
                                </a>

                                <span class="ms-auto small text-muted me-2">
                                    <i class="bi bi-clock-history"></i>
                                    @note.ModifedOn.ToString("dd.MM.yy HH:mm")
                                </span>

                            </div>


                            <!-- Post Image -->

                            @if (string.IsNullOrEmpty(note.NoteImageFilename))
                            {
                                <img class="card-img-top"
                                     src="https://dummyimage.com/700x350/dee2e6/6c757d.jpg"
                                     width="200"
                                     height="200"
                                     alt="Post image" />
                            }
                            else
                            {
                                <img class="card-img-top"
                                     src="~/Images/@(note.NoteImageFilename)"
                                     width="200"
                                     height="200"
                                     alt="Post image" />
                            }


                            <!-- Card Body -->
                            <div class="card-body">

                                <h6 class="fw-bold mb-2">@note.Title</h6>

                                <p class="card-text mb-2">
                                    @if (!string.IsNullOrEmpty(note.Text) && note.Text.Length > 100)
                                    {
                                        @(note.Text.Substring(0, 100) + "...")
                                    }
                                    else
                                    {
                                        @note.Text
                                    }
                                </p>

                                <a href="javascript:void(0)"
                                   class="btn btn-outline-info btn-sm text-decoration-none small fw-semibold"
                                   onclick="openNoteDetailModal(@note.Id)">
                                    Devamını Oku
                                </a>

                            </div>

                            <!-- Card Footer (Actions) -->
                            <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">

                                <button class="btn p-0 like-btn d-flex align-items-center gap-1 like-action"
                                        @(currentUser == null ? "disabled title='Beğenmek için giriş yapmalısınız'" : "")
                                        onclick="toggleLike(@note.Id, this)">

                                    <i class="bi bi-heart like-icon" id="like-icon-@note.Id"></i>

                                    <span class="like-count" id="like-count-@note.Id">
                                        @note.LikeCount
                                    </span>
                                </button>

                                <div>
                                    <button class="btn btn-link text-secondary p-0 me-3"
                                            onclick="openCommentsModal(@note.Id)">
                                        <i class="bi bi-chat-dots fs-5"></i> Yorumlar
                                    </button>

                                </div>

                            </div>

                        </div>


                    </div>

                }


            </div>
            <!-- Pagination-->




            @{
                int totalPages = ViewBag.TotalPages;
                int currentPage = ViewBag.CurrentPage;

                int range = 1; // aktif sayfanın sağ-solunda kaç sayfa gösterilecek
                int start = Math.Max(1, currentPage - range);
                int end = Math.Min(totalPages, currentPage + range);
            }

            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Pagination">
                    <ul class="pagination justify-content-center my-4">

                        <!-- Previous -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link d-flex align-items-center gap-1 text-secondary"
                               href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                    new { page = currentPage - 1 })">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline">Geri</span>
                            </a>
                        </li>

                        @if (start > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                           new { page = 1 })">
                                    1
                                </a>
                            </li>

                            if (start > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (int i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                            new { page = i })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (end < totalPages)
                        {
                            if (end < totalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                                new { page = totalPages })">
                                    @totalPages
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link d-flex align-items-center gap-1 text-secondary"
                               href="@Url.Action(ViewContext.RouteData.Values["action"].ToString(),
                                                new { page = currentPage + 1 })">
                                <span class="d-none d-sm-inline">İleri</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

    </div>
</div>


<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Yorumlar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="commentModalBody">
                <!-- AJAX ile dolacak -->
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="noteDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="noteDetailTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="small text-muted d-flex align-items-center gap-2 mt-3">
                    <div>
                        <img id="noteProfileImg"
                             src="~/Images/user.webp"
                             alt="Profil Fotoğrafı"
                             class="rounded-circle"
                             width="40"
                             height="40" />

                        <span id="noteDetailOwner"></span>
                    </div>
                    |
                    <i class="bi bi-clock-history"></i>
                    <span id="noteDetailDate"></span>
                </div>

                <hr />

                <p id="noteDetailText" style="white-space: pre-line;"></p>
            </div>

        </div>
    </div>
</div>


<script src="~/Scripts/comment.js"></script>
<script src="~/Scripts/Like.js"></script>
<script>
    function openNoteDetailModal(noteId) {

        $.get("/Note/GetNoteDetail", { id: noteId }, function (data) {

            $("#noteDetailTitle").text(data.title);
            $("#noteDetailOwner").text(data.owner);
            $("#noteDetailDate").text(data.date);
            $("#noteDetailText").text(data.text);


            $("#noteProfileImg").attr("src", "/Images/" + data.profileImage);

            var modal = new bootstrap.Modal(document.getElementById('noteDetailModal'));
            modal.show();
        });
    }
</script>


@Html.Partial("_PartialFooter")

