@model MyNotes.Entities.Note

@{
    ViewBag.Title = "Not Silme";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-trash"></i>Not Silme
                    </h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Uyarı!</strong> Bu Eylem Geri Alınamaz
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Kategori</dt>
                        <dd class="col-sm-8">@Model.Category.Title</dd>

                        <dt class="col-sm-4">Sahibi</dt>
                        <dd class="col-sm-8">@Model.Owner.Name</dd>

                        <dt class="col-sm-4">Başlık</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Text</dt>
                        <dd class="col-sm-8">
                            <div class="border rounded p-2 bg-light">
                                @Model.Text
                            </div>
                        </dd>

                        <dt class="col-sm-4">Taslak</dt>
                        <dd class="col-sm-8">
                            @(Model.IsDraft ? "Evet" : "Hayır")
                        </dd>

                        <dt class="col-sm-4">Beğeni Sayısı</dt>
                        <dd class="col-sm-8">@Model.LikeCount</dd>

                        <dt class="col-sm-4">Son Güncelleme</dt>
                        <dd class="col-sm-8">
                            @Model.ModifedOn.ToString("dd.MM.yyyy HH:mm")
                        </dd>
                    </dl>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-between mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-left"></i> İptal
                            </a>

                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fa fa-trash"></i> Sil
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
