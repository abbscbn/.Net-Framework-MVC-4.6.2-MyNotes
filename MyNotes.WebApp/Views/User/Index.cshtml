@using MyNotes.Entities
@model List<EverNoteUser>

@{
    ViewBag.Title = "Kullanıcılar";
}

<div class="container mt-4">

    <!-- Başlık + Yeni Kullanıcı -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            <i class="bi bi-people-fill"></i> Kullanıcılar
        </h3>

        <a href="/User/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Kullanıcı
        </a>
    </div>

    <!-- Kart -->
    <div class="shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Ad</th>
                            <th>Soyad</th>
                            <th>Email</th>
                            <th>Kullanıcı Adı</th>
                            <th>Profil</th>
                            <th class="text-center">Aktif</th>
                            <th class="text-center">Admin</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Surname</td>
                                <td>@item.Email</td>
                                <td>@item.Username</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProfileImageFilename))
                                    {
                                        <img src="~/Images/@item.ProfileImageFilename"
                                             class="rounded-circle"
                                             width="40"
                                             height="40"
                                             alt="Profil">
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>

                                <!-- IsActive -->
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           disabled
                                           @(item.IsActive ? "checked" : "") />
                                </td>

                                <!-- IsAdmin -->
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           disabled
                                           @(item.IsAdmin ? "checked" : "") />
                                </td>

                                <!-- Aksiyonlar -->
                                <td class="text-end">

                                    @MyCustomBootstrap.MyLinkButton($"/User/Edit/{item.Id}", "warning", "pencil", "Düzenle")

                                    @MyCustomBootstrap.MyLinkButton($"/User/Details/{item.Id}", "info", "eye", "Detay")

                                    @MyCustomBootstrap.MyLinkButton($"/User/Delete/{item.Id}", "danger", "trash", "Sil")


                                    @*<a href="/User/Details/@item.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>*@
                                    @*<a href="/User/Delete/@item.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>*@
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="d-lg-none">

                @foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">

                            <!-- Üst: Profil + İsim -->
                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(item.ProfileImageFilename))
                                {
                                    <img src="~/Images/@item.ProfileImageFilename"
                                         class="rounded-circle me-3"
                                         width="50"
                                         height="50"
                                         alt="Profil">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3"
                                         style="width:50px;height:50px;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }

                                <div>
                                    <strong>@item.Name @item.Surname</strong><br />
                                    <small class="text-muted">@item.Username</small>
                                </div>
                            </div>

                            <!-- Email -->
                            <p class="mb-2">
                                <i class="bi bi-envelope-fill"></i>
                                <small>@item.Email</small>
                            </p>

                            <!-- Durumlar -->
                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                        @(item.IsActive ? "Aktif" : "Pasif")
                                    </span>

                                    <span class="badge @(item.IsAdmin ? "bg-warning text-dark" : "bg-light text-dark")">
                                        @(item.IsAdmin ? "Admin" : "Kullanıcı")
                                    </span>
                                </div>

                                <!-- Aksiyonlar -->
                                <div>
                                    @MyCustomBootstrap.MyLinkButton($"/User/Edit/{item.Id}", "warning", "pencil", "Düzenle")

                                    @MyCustomBootstrap.MyLinkButton($"/User/Details/{item.Id}", "info", "eye", "Detay")

                                    @MyCustomBootstrap.MyLinkButton($"/User/Delete/{item.Id}", "danger", "trash", "Sil")

                                </div>
                            </div>

                            

                        </div>
                    </div>
                }

            </div>


        </div>
    </div>

</div>
