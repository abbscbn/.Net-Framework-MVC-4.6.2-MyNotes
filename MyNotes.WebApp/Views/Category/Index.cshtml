@using MyNotes.Entities
@model List<Category>

@{
    ViewBag.Title = "Kategoriler";
}

<div class="container mt-5">

    <!-- BAŞLIK + BUTON -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-tags-fill text-primary"></i> Kategoriler
        </h2>

        <a href="/Category/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Kategori
        </a>
    </div>

    <div class="shadow-sm border-0">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>Oluşturulma</th>
                        <th>Güncellenme</th>
                        <th>Oluşturan</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @item.Title
                            </td>

                            <td class="text-muted" style="max-width:250px;">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @(item.Description.Length > 80
                                        ? item.Description.Substring(0, 80) + "..."
                                        : item.Description)
                                }
                            </td>

                            <td>
                                <span class="badge bg-light text-dark">
                                    @item.CreatedOn.ToString("dd.MM.yyyy")
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @item.ModifedOn.ToString("dd.MM.yyyy")
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @item.ModifiedUsername
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">

                                    <a href="/Category/Edit/@item.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                        <span class="d-none d-md-inline"> Düzenle</span>
                                    </a>

                                    <a href="/Category/Details/@item.Id"
                                       class="btn btn-sm btn-outline-success"
                                       title="Detay">
                                        <i class="bi bi-eye"></i>
                                        <span class="d-none d-md-inline"> Detay</span>
                                    </a>

                                    <a href="#"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Sil"
                                       onclick="return confirmDelete('/Category/Delete/@item.Id')">
                                        <i class="bi bi-trash"></i>
                                        <span class="d-none d-md-inline"> Sil</span>
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>

<script>
    function confirmDelete(url) {
        if (confirm("Bu kategoriyi silmek istediğinize emin misiniz?")) {
            window.location.href = url;
        }
        return false;
    }
</script>

<script>
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el))
</script>

