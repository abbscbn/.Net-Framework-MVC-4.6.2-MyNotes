@using MyNotes.Entities
@model List<Category>

@{
    ViewBag.Title = "Kategoriler";
}

<div class="container mt-4">

    <!-- BAŞLIK + BUTON -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            <i class="bi bi-tags-fill text-primary"></i> Kategoriler
        </h3>

        <a href="/Category/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Kategori
        </a>
    </div>

    <div class="shadow-sm border-0">
        <div class="table-responsive d-none d-lg-block">
            <div class="card-body p-0">

                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Güncellenme</th>
                            <th>Oluşturan</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.Title
                                </td>

                                <td class="text-muted" style="max-width:250px;">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 80
                                        ? item.Description.Substring(0, 80) + "..."
                                        : item.Description)
                                    }
                                </td>



                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.ModifedOn.ToString("dd.MM.yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.ModifiedUsername
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-1">


                                        @MyCustomBootstrap.MyLinkButton($"/Category/Edit/{item.Id}", "warning", "pencil", "Düzenle")

                                        @MyCustomBootstrap.MyLinkButton($"/Category/Details/{item.Id}", "info", "eye", "Detay")

                                        @MyCustomBootstrap.MyLinkButton($"/Category/Delete/{item.Id}", "danger", "trash", "Sil")

                                        @*<a href="/Category/Edit/@item.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <a href="/Category/Details/@item.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                        <a href="/Category/Delete/@item.Id" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </a>*@

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
            </div>

            <!-- Mobile Cards -->
            <div class="d-lg-none">
                @foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title fw-bold">@item.Title</h5>

                            </div>

                            <h6 class="text-muted">@item.Description</h6>


                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    @item.CreatedOn.ToString("dd.MM.yyyy")
                                </small>

                                <div>
                                    

                                    @MyCustomBootstrap.MyLinkButton($"/Category/Edit/{item.Id}", "warning", "pencil", "Düzenle")

                                    @MyCustomBootstrap.MyLinkButton($"/Category/Details/{item.Id}", "info", "eye", "Detay")

                                    @MyCustomBootstrap.MyLinkButton($"/Category/Delete/{item.Id}", "danger", "trash", "Sil")

                                    @*<a href="/Category/Edit/@item.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>
                                    <a href="/Category/Details/@item.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Detay
                                    </a>
                                    <a href="/Category/Delete/@item.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>*@
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>


        </div>
    </div>



