@model MyNotes.Entities.Category

@{
    ViewBag.Title = "Kategori Düzenle";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-12">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-pencil-square"></i> Kategori Düzenle
                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Id)

                        @Html.ValidationSummary(true)

                        <!-- Kategori Başlık -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.Title, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.Title, new
                            {
                                @class = "form-control",
                                placeholder = "Kategori başlığı giriniz"
                            })
                           
                        </div>

                        <!-- Kategori Açıklama -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.Description, new { @class = "form-label fw-semibold" })
                            @Html.TextAreaFor(model => model.Description, new
                            {
                                @class = "form-control",
                                rows = 4,
                                placeholder = "Kategori açıklaması (isteğe bağlı)"
                            })
                        
                        </div>

                        <hr />

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between">
                            <a href="/Category/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Kaydet
                            </button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
