@model MyNotes.Entities.Category

@{
    ViewBag.Title = "Yeni Kategori Oluştur";
}

<div class="container mt-5">

    <!-- BAŞLIK -->
    <div class="row mb-3">
        <div class="col">
            <h2>
                <i class="bi bi-folder-plus"></i> @ViewBag.Title
            </h2>
            <hr />
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-success text-white">
                    <i class="bi bi-plus-circle"></i> Kategori Bilgileri
                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                        <!-- BAŞLIK -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Title, new
                            {
                                @class = "form-control",
                                placeholder = "Kategori başlığını giriniz"
                            })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>

                        <!-- AÇIKLAMA -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Description, new
                            {
                                @class = "form-control",
                                rows = 4,
                                placeholder = "Kategori açıklaması giriniz"
                            })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>

                        <hr />

                        <!-- BUTONLAR -->
                        <div class="d-flex justify-content-between">
                            <a href="/Category/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Kaydet
                            </button>
                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

</div>
