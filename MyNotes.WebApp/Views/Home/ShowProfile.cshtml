@using MyNotes.Entities;
@model EverNoteUser

@{

    ViewBag.Title = "Kullanıcı Profili";

}

<div class="container mt-5">

    <div class="row">
        <h2>@ViewBag.Title</h2>
        <hr />
    </div>

    <div class="row">


        <!-- SOL: PROFİL KARTI -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">

                    <img src="~/Images/@(string.IsNullOrEmpty(Model.ProfileImageFilename)
                        ? "user.webp"
                        : Model.ProfileImageFilename)"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150"
                         style="object-fit:cover;" />

                    <h4 class="mb-0">@Model.Username</h4>
                    <small class="text-muted">@Model.Email</small>

                    <div class="mt-3">
                        @if (Model.IsAdmin)
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success ms-1">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-1">Inactive</span>
                        }
                    </div>

                    <hr />

                    @*<a href="#" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-pencil-square"></i> Profili Düzenle
                        </a>*@

                    <div class="dropdown w-100">
                        <button class="btn btn-outline-primary btn-sm w-100 dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-gear"></i> İşlemler
                        </button>

                        <ul class="dropdown-menu w-100 text-center">
                            <li>
                                <a class="dropdown-item" href="/Home/EditProfile">
                                    <i class="bi bi-pencil-square text-primary"></i> Profili Düzenle
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   href="#"
                                   onclick="return confirmDelete('/Home/DeleteProfile/@Model.Id');">
                                    <i class="bi bi-trash"></i> Profili Sil
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>

        <!-- SAĞ: DETAY BİLGİLER -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-lines-fill"></i> Kullanıcı Bilgileri
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr> 
                            <th>@Html.DisplayNameFor(Model=>Model.Name)</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model=>Model.Surname)</th>
                            <td>@Model.Surname</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model=>Model.Username)</th>
                            <td>@Model.Username</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.Username)</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Kayıt Tarihi</th>
                            <td>@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Son Güncelleme</th>
                            <td>@Model.ModifedOn.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- İSTATİSTİKLER -->
            <div class="row mt-3">
                @if (Model.Notes.Count > 0)
                {
                    <div class="col-md-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-journal-text fs-2 text-primary"></i>
                                <h5 class="mt-2">@Model.Notes.Count</h5>
                                <small class="text-muted">Not</small>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Comments.Count > 0)
                {
                    <div class="col-md-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-chat-dots fs-2 text-success"></i>
                                <h5 class="mt-2">@Model.Comments.Count</h5>
                                <small class="text-muted">Yorum</small>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Likes.Count>0)
                {
                    <div class="col-md-4">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-heart fs-2 text-danger"></i>
                                <h5 class="mt-2">@Model.Likes.Count</h5>
                                <a href="/Note/MyLikedNotes"><small class="text-muted">Beğeni</small></a>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    function confirmDelete(url) {
        if (confirm("Profilinizi silmek istediğinize emin misiniz?\nBu işlem geri alınamaz!")) {
            window.location.href = url;
        }
        return false;
    }
</script>

@Html.Partial("_PartialFooter")
