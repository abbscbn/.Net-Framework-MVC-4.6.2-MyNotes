@using MyNotes.Entities;
@using MyNotes.WebApp.Models;
@model EverNoteUser

@{

    ViewBag.Title = "Kullanıcı Profili";

}

<div class="container mt-5">


    @if (Model.Id == CurrentSession.User.Id)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold">@ViewBag.Title</h3>
            <a href="/Note/Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Yeni Tarif
            </a>
        </div>
    }

    @{
        EverNoteUser currentUser = CurrentSession.User;
    }


    <div class="row">


        <!-- SOL: PROFİL KARTI -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">

                    <img src="~/Images/@(string.IsNullOrEmpty(Model.ProfileImageFilename)
                        ? "user.webp"
                        : Model.ProfileImageFilename)"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150"
                         style="object-fit:cover;" />

                    <h4 class="mb-0">@Model.Username</h4>
                    <small class="text-muted">@Model.Email</small>

                    <div class="mt-3">
                        @if (Model.IsAdmin)
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success ms-1">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-1">Inactive</span>
                        }


                    </div>

                    <hr />

                    @*<a href="#" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-pencil-square"></i> Profili Düzenle
                        </a>*@

                    @if (currentUser.Id == Model.Id)
                    {
                        <div class="dropdown w-100">
                            <button class="btn btn-outline-primary btn-sm w-100 dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-gear"></i> İşlemler
                            </button>

                            <ul class="dropdown-menu w-100 text-center">
                                <li>
                                    <a class="dropdown-item" href="/Home/EditProfile">
                                        <i class="bi bi-pencil-square text-primary"></i> Profili Düzenle
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider">
                                </li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="#"
                                       onclick="return confirmDelete('/Home/DeleteProfile/@Model.Id');">
                                        <i class="bi bi-trash"></i> Profili Sil
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ: DETAY BİLGİLER -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-lines-fill"></i> Kullanıcı Bilgileri
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.Name)</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.Surname)</th>
                            <td>@Model.Surname</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.Username)</th>
                            <td>@Model.Username</td>
                        </tr>
                        <tr>
                            <th>@Html.DisplayNameFor(Model => Model.Email)</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Kayıt Tarihi</th>
                            <td>@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>

                    </table>
                </div>
            </div>

            <!-- İSTATİSTİKLER -->
            <div class="row mt-3">
                @if (Model.Id == currentUser.Id)
                {

                    if (Model.Notes != null && Model.Notes.Count > 0)
                    {
                        <div class="col-md-6">
                            <a href="/Note/MyNotes">
                                <div class="card text-center shadow-sm">
                                    <div class="card-body">
                                        <i class="bi bi-journal-text fs-2 text-primary"></i>
                                        <h5 class="mt-2">@Model.Notes.Count</h5>
                                        <small class="text-muted">Tarifler</small>

                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    else
                    {
                        <div class="col-md-6">

                            <div class="card text-center shadow-sm">
                                <div class="card-body">
                                    <i class="bi bi-journal-text fs-2 text-primary"></i>
                                    <h5 class="mt-2">0</h5>
                                    <small class="text-muted">Tarifler</small>

                                </div>
                            </div>

                        </div>
                    }


                }

                else
                {
                    if (Model.Notes.Count > 0)
                    {
                        <div class="col-md-12">
                            <a href="/Note/OtherUserNotes/@Model.Id">
                                <div class="card text-center shadow-sm">
                                    <div class="card-body">
                                        <i class="bi bi-journal-text fs-2 text-primary"></i>
                                        <h5 class="mt-2">@Model.Notes.Count</h5>
                                        <small class="text-muted">Tarifler</small>

                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    else
                    {
                        <div class="col-md-12">

                            <div class="card text-center shadow-sm">
                                <div class="card-body">
                                    <i class="bi bi-journal-text fs-2 text-primary"></i>
                                    <h5 class="mt-2">0</h5>
                                    <small class="text-muted">Tarifler</small>

                                </div>
                            </div>

                        </div>
                    }
                }

                @if (Model.Id == currentUser.Id)
                {

                    if (Model.Likes != null && Model.Likes.Count > 0)
                    {
                        <div class="col-md-6">
                            <a href="/Note/MyLikedNotes">
                                <div class="card text-center shadow-sm">
                                    <div class="card-body">
                                        <i class="bi bi-heart fs-2 text-danger"></i>
                                        <h5 class="mt-2">@Model.Likes.Count</h5>
                                        <small class="text-muted">Beğeni</small>

                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">

                            <div class="card text-center shadow-sm">
                                <div class="card-body">
                                    <i class="bi bi-heart fs-2 text-danger"></i>
                                    <h5 class="mt-2">0</h5>
                                    <small class="text-muted">Beğeni</small>

                                </div>
                            </div>

                        </div>
                    }

                }
            </div>

        </div>
    </div>
</div>

<script>
    function confirmDelete(url) {
        if (confirm("Profilinizi silmek istediğinize emin misiniz?\nBu işlem geri alınamaz!")) {
            window.location.href = url;
        }
        return false;
    }
</script>

@Html.Partial("_PartialFooter")
