@using MyNotes.Entities.ValueObjects
@model LoginViewModel
@{
    ViewBag.Title = "Login";
}

<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.8/css/all.css">

<style type="text/css">
    .validation-summary-errors {
        border: 1px solid black;
        border-radius: 8px;
        background-color: #df4747;
        color: white;
    }

        .validation-summary-errors ul {
            padding: 10px;
        }

        .validation-summary-errors li {
            list-style-type: none;
        }
</style>

<div class="container">

    @using(Html.BeginForm())
    { 
    <div class="row">
        <div class="col-md-3">

        </div>

        <div class="col-md-6">

            <article class="card-body">
                <h4 class="card-title text-center mb-4 mt-1">Giriş</h4>
                <hr>
                @Html.ValidationSummary(false)
                @*<p class="text-success text-center">Some message goes here</p>*@

                @if (ViewBag.ActivationMessage != null)
                {
                    <div class="alert alert-success text-center">
                      
                        <a  class="btn btn-primary" href="@ViewBag.ActivationMessage">Aktifle</a>
                       
                    </div>
                }
                <form>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"> <i class="fas fa-envelope"></i> </span>
                            </div>
                            @Html.TextBoxFor(model => model.Username, new { @class = "form-control", placeholder = "Kullanıcı adı", type = "text" })
                            @*<input name="" class="form-control" placeholder="Email" type="email">*@
                        </div> <!-- input-group.// -->
                    </div> <!-- form-group// -->
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"> <i class="fa fa-lock"></i> </span>
                            </div>
                            @Html.TextBoxFor(model => model.Password, new { @class = "form-control", placeholder = "Şifre", type = "password" })
                            @*<input class="form-control" placeholder="Şifre" type="password">*@
                        </div> <!-- input-group.// -->
                    </div> <!-- form-group// -->
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary btn-block">Giriş</button>
                    </div> <!-- form-group// -->

                </form>
            </article>

        </div>

        <div class="col-md-3">

        </div>
    </div>
    }

    
</div>

<script>

    $(function () {
        $("h1").hide();
        $("footer").hide();
    })

</script>

