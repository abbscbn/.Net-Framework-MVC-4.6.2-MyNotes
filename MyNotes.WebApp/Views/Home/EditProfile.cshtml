@using MyNotes.Entities
@model EverNoteUser


@{
    ViewBag.Title = "Profili Düzenle";
}

<style type="text/css">
    .validation-summary-errors {
        
        
        color: red;
    }

        .validation-summary-errors ul {
            padding: 10px;
        }

        .validation-summary-errors li {
            list-style-type: none;
        }
</style>

<div class="container mt-5">

    <div class="row">
        <h2>@ViewBag.Title</h2>
        <hr />
    </div>

    @using (Html.BeginForm("EditProfile", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">

            <!-- SOL: PROFİL FOTO -->
            <div class="col-md-4">
                <div class="card shadow-sm text-center">
                    <div class="card-body">
                        @Html.HiddenFor(Model=>Model.ProfileImageFilename)
                        <img src="~/Images/@(string.IsNullOrEmpty(Model.ProfileImageFilename)
                            ? "user.webp"
                            : Model.ProfileImageFilename)"
                             class="rounded-circle mb-3"
                             width="150"
                             height="150"
                             style="object-fit:cover;" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Profil Resmi</label>
                            <input type="file"
                                   name="ProfileImage"
                                   class="form-control form-control-sm"
                                   accept="image/*" />
                        </div>

                        <small class="text-muted">
                            JPG, PNG veya WEBP yükleyebilirsiniz
                        </small>

                    </div>
                </div>
            </div>

            <!-- SAĞ: FORM -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-pencil-square"></i> Profil Bilgileri
                    </div>

                    <div class="card-body">

                        @Html.ValidationSummary(false)

                        @Html.HiddenFor(Model => Model.Id)

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(Model => Model.Name, new { @class = "form-label" })
                                @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(Model => Model.Surname, new { @class = "form-label" })
                                @Html.TextBoxFor(Model => Model.Surname, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(Model => Model.Username, new { @class = "form-label" })
                            @Html.TextBoxFor(Model => Model.Username, new { @class = "form-control" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(Model => Model.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(Model => Model.Email, new { @class = "form-control", type = "email" })
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label">
                                Yeni Şifre
                                <small class="text-muted">(Boş bırakılırsa değişmez)</small>
                            </label>
                            <input type="password"
                                   name="Password"
                                   class="form-control" />
                        </div>

                    </div>

                    <div class="card-footer text-end">
                        <a href="/Home/ShowProfile" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Vazgeç
                        </a>

                        <button type="submit" class="btn btn-primary ms-2">
                            <i class="bi bi-save"></i> Kaydet
                        </button>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

