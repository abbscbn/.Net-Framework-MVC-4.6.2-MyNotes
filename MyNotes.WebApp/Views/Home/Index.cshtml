@using MyNotes.Entities;

@model List<Note>

@{
    ViewBag.Title = "Index";



}
@{
    var currentUser = Session["login"] as EverNoteUser;
}

<style>
    .comment-text[contenteditable="true"] {
        border: 1px solid #0d6efd;
        padding: 6px;
        border-radius: 4px;
        background-color: #f8f9fa;
    }
</style>


@Html.Partial("_PartialHeader")
<div class="container-xxl">
    <div class="row">
        <!-- Side widgets-->
        <div class="col-md-3">
            <!-- Search widget-->
            @*<div class="card mb-4">
                    <div class="card-header">Search</div>
                    <div class="card-body">
                        <div class="input-group">
                            <input class="form-control" type="text" placeholder="Enter search term..." aria-label="Enter search term..." aria-describedby="button-search" />
                            <button class="btn btn-primary" id="button-search" type="button">Go!</button>
                        </div>
                    </div>
                </div>*@
            <!-- Categories widget-->
            <div class="mb-4 col-lg-12">
                @Html.Partial("_PartialCategory")
            </div>

        </div>
        <!-- Blog entries-->
        <div class="col-md-9">

            <!-- Nested row for non-featured blog posts-->
            <div class="row">


                @foreach (Note note in Model)
                {
                    <div class="col-lg-6" data-note-id="@note.Id">
                        <!-- Blog post-->
                        <div class="card mb-4">
                            <a href="#!"><img class="card-img-top" src="https://dummyimage.com/700x350/dee2e6/6c757d.jpg" alt="..." /></a>
                            <div class="card-body">
                                <div class="small text-muted"><i class="bi bi-clock-history"></i> @note.ModifedOn.ToString("dd.MM.yy.HH:mm")</div>
                                <div class="small text-muted d-flex align-items-center gap-2 mt-3">
                                    <img src="~/Images/@(note.Owner.ProfileImageFilename ?? "user.webp")"
                                         alt="Profil Fotoğrafı"
                                         class="rounded-circle"
                                         width="40"
                                         height="40" />

                                    <span>@note.Owner.Username</span>
                                </div>
                                <h2 class="card-title h5 fw-bold my-2">@note.Title</h2>
                                <p class="card-text">
                                    @if (string.IsNullOrEmpty(note.Text) == false && note.Text.Length > 100)
                                    {
                                        @(note.Text.Substring(0, 100) + "...")

                                    }
                                    else
                                    {
                                        @note.Text
                                    }
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-3">

                                    <button class="btn btn-outline-danger btn-sm like-btn"
                                            @(currentUser == null ? "disabled title='Beğenmek için giriş yapmalısınız'" : "")
                                            onclick="toggleLike(@note.Id, this)">

                                        <i class="bi bi-heart" id="like-icon-@note.Id"></i>
                                        <span id="like-count-@note.Id">@note.LikeCount</span>

                                    </button>

                                    <div>
                                        <a class="btn btn-outline-secondary btn-sm"
                                           href="javascript:void(0)"
                                           data-note-id="@note.Id"
                                           onclick="openCommentsModal(@note.Id)">
                                            <i class="bi bi-chat-dots"></i> Yorumlar
                                        </a>

                                        <a class="btn btn-primary btn-sm"
                                           href="javascript:void(0)"
                                           onclick="openNoteDetailModal(@note.Id)">
                                            Devamı
                                        </a>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                }


            </div>
            <!-- Pagination-->
            <nav aria-label="Pagination">
                <hr class="my-0" />
                <ul class="pagination justify-content-center my-4">
                    <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Newer</a></li>
                    <li class="page-item active" aria-current="page"><a class="page-link" href="#!">1</a></li>
                    <li class="page-item"><a class="page-link" href="#!">2</a></li>
                    <li class="page-item"><a class="page-link" href="#!">3</a></li>
                    <li class="page-item disabled"><a class="page-link" href="#!">...</a></li>
                    <li class="page-item"><a class="page-link" href="#!">15</a></li>
                    <li class="page-item"><a class="page-link" href="#!">Older</a></li>
                </ul>
            </nav>
        </div>

    </div>
</div>


<div class="modal fade" id="commentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Yorumlar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="commentModalBody">
                <!-- AJAX ile dolacak -->
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="noteDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="noteDetailTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="small text-muted d-flex align-items-center gap-2 mt-3">
                    <div>
                        <img id="noteProfileImg"
                             src="~/Images/user.webp"
                             alt="Profil Fotoğrafı"
                             class="rounded-circle"
                             width="40"
                             height="40" />

                        <span id="noteDetailOwner"></span>
                    </div>
                    |
                    <i class="bi bi-clock-history"></i>
                    <span id="noteDetailDate"></span>
                </div>

                <hr />

                <p id="noteDetailText"></p>
            </div>

        </div>
    </div>
</div>


<script src="~/Scripts/comment.js"></script>
<script src="~/Scripts/Like.js"></script>
<script>
    function openNoteDetailModal(noteId) {

        $.get("/Note/GetNoteDetail", { id: noteId }, function (data) {

            $("#noteDetailTitle").text(data.title);
            $("#noteDetailOwner").text(data.owner);
            $("#noteDetailDate").text(data.date);
            $("#noteDetailText").text(data.text);


            $("#noteProfileImg").attr("src", "/Images/" + data.profileImage);

            var modal = new bootstrap.Modal(document.getElementById('noteDetailModal'));
            modal.show();
        });
    }
</script>


@Html.Partial("_PartialFooter")

