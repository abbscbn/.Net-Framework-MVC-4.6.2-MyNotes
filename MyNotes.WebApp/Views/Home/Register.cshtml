@using MyNotes.Entities.ValueObjects
@model RegisterViewModel
@{
    ViewBag.Title = "Register";
}



<style type="text/css">
    .validation-summary-errors {
        border: 1px solid black;
        border-radius: 8px;
        background-color: #f8f9fa;
        color: black;
    }
        .validation-summary-errors ul {
            padding:10px;
        }

    .validation-summary-errors li{
        list-style-type: none;
    }
</style>


<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-5">

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">

                <h4 class="text-center mb-3 fw-bold">Kayıt Ol</h4>
                <p class="text-center text-muted mb-4">
                    Tarifçim hesabını oluştur
                </p>

                @Html.ValidationSummary(false)

                @using (Html.BeginForm())
                {
                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label">Kullanıcı Adı</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            @Html.TextBoxFor(x => x.Username, new
                            {
                                @class = "form-control",
                                placeholder = "Kullanıcı adınız"
                            })
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            @Html.TextBoxFor(x => x.Email, new
                            {
                                @class = "form-control",
                                placeholder = "email@example.com",
                                type = "email"
                            })
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            @Html.PasswordFor(x => x.Password, new
                            {
                                @class = "form-control",
                                placeholder = "Şifreniz"
                            })
                        </div>
                    </div>

                    <!-- RePassword -->
                    <div class="mb-4">
                        <label class="form-label">Şifre (Tekrar)</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            @Html.PasswordFor(x => x.RePassword, new
                            {
                                @class = "form-control",
                                placeholder = "Şifrenizi tekrar girin"
                            })
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        Kayıt Ol
                    </button>
                }

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Zaten hesabın var mı?
                    <a href="/Home/Login" class="fw-semibold text-decoration-none">
                        Giriş yap
                    </a>
                </p>

            </div>
        </div>

    </div>
</div>


