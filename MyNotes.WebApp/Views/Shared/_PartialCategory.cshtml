@using MyNotes.BusinessLayer
@using MyNotes.Entities

@{
    CategoryManager cm = new CategoryManager();
    List<Category> list = cm.List();
}

<!-- Mobil Toggle -->
<button class="btn btn-outline-secondary d-md-none mb-2 w-100"
        data-bs-toggle="collapse"
        data-bs-target="#categoryList">
    <i class="bi bi-list"></i> Kategoriler
</button>

<!-- Category List -->
<div class="collapse d-md-block show" id="categoryList">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-none d-md-block">
            <h5 class="mb-0 text-center">
                <i class="fa fa-list"></i> Kategoriler
            </h5>
        </div>

        <div class="list-group list-group-flush">
            @foreach (Category cat in list)
            {
                <a href="/Home/ByCategory/@cat.Id"
                   class="list-group-item @(ViewBag.ActiveCategoryId == cat.Id ? "active" : "")
                          list-group-item-action d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fa fa-tag text-secondary me-2"></i>
                        @cat.Title
                    </span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            }
        </div>
    </div>
</div>


