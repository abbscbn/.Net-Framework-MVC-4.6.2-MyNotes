@using MyNotes.Entities

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Blog Home - Start Bootstrap Template</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Core theme CSS (includes Bootstrap)-->

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!--<link href="css/styles.css" rel="stylesheet" />-->
    <!--benim yazdığım custom css override edebilmesi için aşağıda olması gerekir-->
    <link href="~/Content/Site.css" rel="stylesheet" />
    <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>-->
    <!-- Core theme JS-->
    @*Eğer bootstrap 5 versiyonunu kullanıyorsam artık jquery kullanmama gerek yok*@
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <!--buradaki ekleme sırası jquery ilk önce olacak çünkü, bootstrap jquery e bağlıdır ilk önce onun tanımlanması gerekir-->
    @*<script src="~/Scripts/bootstrap.min.js"></script>*@
    @*Bootstrap bundle min js içerisinde min.js de mevcut*@

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>


    <!--varsa en aşağıda custom js eklenir-->
</head>
<body>

    @{
        EverNoteUser user = null;

        if (Session["login"] != null)
        {
            user = Session["login"] as EverNoteUser;
        }

    }



    <!-- Responsive navbar-->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand fw-bold text-primary" href="/">
                Tariflerim
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <!-- Sol Menü -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">

                    @if (user != null && user.IsAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-tools me-1"></i> Yönetim
                            </a>

                            <ul class="dropdown-menu shadow-sm">
                                <li>
                                    <a class="dropdown-item" href="/User/Index">
                                        <i class="bi bi-people me-2"></i> Kullanıcılar
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Category/Index">
                                        <i class="bi bi-tags me-2"></i> Kategoriler
                                    </a>
                                </li>
                                @*<li>
                                    <a class="dropdown-item" href="/Note/Index">
                                        <i class="bi bi-journal-text me-2"></i> Notlarım
                                    </a>
                                </li>*@
                            </ul>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="/Home/MostLiked">
                            <i class="bi bi-heart-fill text-danger me-1"></i> En Beğenilenler
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="/Home/Index">
                            <i class="bi bi-clock-history me-1"></i> Son Tarifler
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="/Home/About">
                            <i class="bi bi-info-circle me-1"></i> Hakkımızda
                        </a>
                    </li>

                </ul>

                <!-- Sağ Menü -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2 gap-2">

                    @if (user == null)
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm px-3"
                               href="/Home/Login">
                                Giriş
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3"
                               href="/Home/Register">
                                Üye Ol
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <img src="~/Images/@(user.ProfileImageFilename ?? "user.webp")"
                                     class="rounded-circle border"
                                     width="32"
                                     height="32" />

                                <span class="fw-semibold">@user.Username</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <a class="dropdown-item" href="/Home/MyProfile">
                                        <i class="bi bi-person me-2"></i> Profilim
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/Home/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Çıkış
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- Page header with logo and tagline-->
    @RenderSection("Header", required: false)

    
        @RenderBody()
    
    <!-- Footer-->
    @RenderSection("footer", required: false)
    <!-- Bootstrap core JS-->
    @RenderSection("scripts", required: false)
</body>
</html>
