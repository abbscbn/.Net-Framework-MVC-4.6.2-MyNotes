@using MyNotes.Entities.Messages
@using MyNotes.WebApp.ViewModels
@model ErrorViewModel

@{
    ViewBag.Title = "Bilgilendirme Sayfası";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-lg border-0 text-center p-4">

                <!-- ÜST BAŞLIK -->
                <h5 class="text-muted mb-3">
                    @Model.Header
                </h5>

                <!-- ICON + DURUM -->
                <div class="my-3">
                    <i class="bi-x-circle-fill display-1 text-danger"></i>
                </div>

                <h3 class="fw-bold text-danger">
                    @Model.Title
                </h3>

                <!-- MESAJ -->
                @foreach (ErrorMessageObj errorMessageObj in Model.Items)
                {
                    <p class="text-secondary mt-3">
                        @errorMessageObj.Message
                    </p>
                }


                @if (Model.IsRedirectingUrl)
                {
                    <!-- GERİ SAYIM -->
                    <p class="small text-muted mt-4">
                        <i class="bi bi-clock-history"></i>
                        <span id="countdown">@Model.RedirectingTimeout</span> saniye içinde yönlendirileceksiniz...
                    </p>

                    <!-- BUTON -->
                    <a href="@Model.RedirectingUrl" class="btn btn-outline-info mt-3">
                        <i class="bi bi-arrow-right-circle"></i> Devam Et
                    </a>
                }

            </div>

        </div>
    </div>
</div>





@if (Model.IsRedirectingUrl)
{
    @section Scripts{
        <script>
        var seconds = @Model.RedirectingTimeout;
        var countdownElement = document.getElementById('countdown');
        setInterval(function () {
            if (seconds > 0) {
                seconds--;
                countdownElement.textContent = seconds;
            } else {
                window.location.href = "@Model.RedirectingUrl";
            }
        }, 1000);
        </script>
    }
}






