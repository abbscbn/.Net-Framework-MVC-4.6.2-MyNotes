@using MyNotes.Entities
@model List<Comment>

@{
    var currentUser = Session["login"] as EverNoteUser;
}


@foreach (var comment in Model)
{
    <div class="border rounded p-2 mb-2" id="comment-container-@comment.Id">

        <div class="d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center">
                <img src="~/Images/@comment.Owner.ProfileImageFilename"
                     class="rounded-circle me-2"
                     width="40"
                     height="40"
                     alt="profil" />

                <strong>@comment.Owner.Username</strong>
            </div>

            <small class="text-muted">
                @comment.ModifedOn.ToString("dd.MM.yyyy HH:mm")
            </small>

        </div>


        <div class="mt-3">
            <p id="comment-text-@comment.Id"
               class="comment-text"
               data-editing="false">
                @comment.Text
            </p>
        </div>

        @if (currentUser != null && currentUser.Id == comment.Owner.Id)
        {
            <div class="text-end">
                <button class="btn btn-sm btn-warning"
                        id="edit-btn-@comment.Id"
                        onclick="editComment(@comment.Id)">
                    <i class="bi bi-pencil"></i>
                </button>

                <button class="btn btn-sm btn-danger"
                        onclick="deleteComment(@comment.Id)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        }
    </div>
}


@if (currentUser != null)
{
    <hr />
    <form id="commentForm">
        <input type="hidden" name="NoteId" value="@ViewBag.NoteId" />

        <textarea name="Text"
                  class="form-control mb-2"
                  rows="3"
                  placeholder="Yorumunuzu yazın..."></textarea>

        <button type="button"
                class="btn btn-primary"
                onclick="addComment()">
            Yorum Ekle
        </button>
    </form>
}
else
{
    <div class="alert alert-info">
        Yorum yapabilmek için giriş yapmalısınız.
    </div>
}

